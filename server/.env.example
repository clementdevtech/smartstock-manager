# Copy these entries into server/.env and replace placeholders with real values.
# Never commit server/.env or share its contents.

# Required for production; generate a long random value locally.
SMARTSTOCK_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# SmartStock server PostgreSQL connection string (keep credentials private).
SMARTSTOCK_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
SMARTSTOCK_CLIENT_ORIGIN=http://localhost:5173
SMARTSTOCK_POSTGRES_ONLINE=true

# PostgreSQL TLS: leave PGSSL unset to use TLS; do not set it to disable in production.
SMARTSTOCK_PGSSL=
SMARTSTOCK_PGSSL_REJECT_UNAUTHORIZED=true

# Optional Cloudinary uploads. Leave blank if Cloudinary is not configured.
SMARTSTOCK_CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUDINARY_CLOUD_NAME
SMARTSTOCK_CLOUDINARY_API_KEY=REPLACE_WITH_CLOUDINARY_API_KEY
SMARTSTOCK_CLOUDINARY_API_SECRET=REPLACE_WITH_CLOUDINARY_API_SECRET

# Zoho OAuth / Mail API. Request offline access and scopes:
# ZohoMail.accounts.READ and ZohoMail.messages.CREATE
ZOHO_ACCOUNTS_HOST=accounts.zoho.com
ZOHO_CLIENT_ID=REPLACE_WITH_ZOHO_CLIENT_ID
ZOHO_CLIENT_SECRET=REPLACE_WITH_ZOHO_CLIENT_SECRET
ZOHO_FROM=REPLACE_WITH_VERIFIED_SENDER_EMAIL
ZOHO_MAIL_HOST=mail.zoho.com
# Must exactly match the redirect URI registered with Zoho; used during OAuth setup.
ZOHO_REDIRECT_URI=REPLACE_WITH_REGISTERED_REDIRECT_URI
ZOHO_REFRESH_TOKEN=REPLACE_WITH_ZOHO_REFRESH_TOKEN

# Optional local-development settings.
# SMARTSTOCK_APP_DATA=REPLACE_WITH_LOCAL_DATA_DIRECTORY
# PORT=3333
# NODE_ENV=development
